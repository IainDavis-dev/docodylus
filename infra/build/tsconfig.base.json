{
    "compilerOptions": {
      // package config
      "baseUrl": "../../../",
      "target": "ESNext",
      "module": "ESNext",
      "moduleResolution": "bundler",
      "composite": true,

      // dependencies
      "lib": ["dom", "esnext"],
      "jsx": "react-jsx",
      "types": [
        "vite/client",
        "vitest/globals",
        "react",
        "react-dom",
        "node-polyglot",
      ],

      // type-checking and validation
      "strict": true,
      "esModuleInterop": true,
      "allowSyntheticDefaultImports": true,
      "noImplicitAny": true,
      "forceConsistentCasingInFileNames": true,

      "paths": {
          // infra, docs, & test stuff
          "@docs/*": ["docs/*"],
          "@dummies/*": ["infra/dummies/*"],
          "@storybook-customizations/*": ["infra/storybook/customizations/*"],
          "@test-utils/*": ["infra/test/utils/*"],

          // library components
          "@components/*": ["packages/components/*"],

          // cross-cutting modules
          "@consts": ["packages/common/consts/internal"],
          "@error": ["packages/common/error/internal"],
          "@i18n": ["packages/common/i18n/internal"],
          "@i18n-extend": ["packages/common/i18n/extend"],
          "@loadable": ["packages/common/loadable/internal"],
          "@namespace/*": ["packages/common/namespace/internal"],
          "@validation/*": ["packages/common/validation/internal"],
      },
    },
  }