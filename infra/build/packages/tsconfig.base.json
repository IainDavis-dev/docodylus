{
    "compilerOptions": {
      "target": "ESNext",
      "module": "ESNext",
      "jsx": "react-jsx",
      "declaration": true,
      "outDir": "dist",
      "moduleResolution": "Node",
      "esModuleInterop": true,
      "strict": true,
      "composite": true,
      "types": ["vitest/globals"]
    },
    "exclude": [
      "**/dist",
      "**/*.test-d.ts",
      "**/*.test.*",
      "**/*.test-d.ts",
      "**/__mocks__",
      "**/__snapshots__",
    ]
  }