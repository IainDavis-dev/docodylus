{
    "name": "@docodylus/i18n-internal",
    "version": "0.0.1-prerelease.3",
    "license": "Apache-2.0",
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "development":  "./index.ts",
            "import": "./dist/esm/index.mjs",
            "require": "./dist/cjs/index.cjs",
            "types": "./dist/index.d.ts"
        }
    },
    "files": [
        "dist/esm",
        "dist/cjs",
        "dist/index.d.ts"
    ],
    "dependencies": {
        "@docodylus/error-internal": "workspace:*",
        "@docodylus/i18n-extend": "workspace:*",
        "@docodylus/loadable-internal": "workspace:*",
        "@docodylus/namespace-internal": "workspace:*"
    },
    "scripts": {
        "generate-locales": "node scripts/generate-valid-locales.mjs",
        "build": "yarn generate-locales; ../../../../node_modules/.bin/vite build",
        "clean": "rm -rf dist",
        "lint": "eslint . --ext .ts",
        "test:unit": "TEST_GROUP=UNIT ../../../../node_modules/.bin/vitest run",
        "test:integration": "TEST_GROUP=INTEGRATION ../../../../node_modules/.bin/vitest run"
    }
}
