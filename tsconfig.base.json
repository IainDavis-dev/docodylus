// common compilerOptions shared among all packages and the library itself
{
    "compilerOptions": {
        "jsx": "react-jsx",
        "lib": ["dom", "esnext"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "typeRoots": ["node_modules/@types"], "target": "esnext",
        "strict": true,
        "noImplicitAny": true,
        "baseUrl": "./",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "paths": {
            "@components/*": ["src/components/*"],
            "@error/*": ["src/common/error/src/*"],
            "@i18n/*": ["src/common/i18n/internal/src/*"],
            "@namespace/*": ["src/common/namespace/src/*"],
            "@validation/*": ["src/common/validation/src/*"],
            "@types/*": ["src/types/*"],
            "@dummies/*": ["infra/dummies/*"],
            "@docs/*": ["docs/*"],
            "@shared-utils/*": ["src/common/shared-utils/*"],
            "@test-utils/*": ["infra/testUtils/*"],
            "@storybook-customizations/*": ["infra/storybook/customizations/*"],
        },
        "types": [
            "react",
            "react-dom",
            "node-polyglot"
        ],
    },
    "exclude": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.stories.tsx",
        "**/dist",
        "__mocks__",
        "__snapshots__"
    ]

}